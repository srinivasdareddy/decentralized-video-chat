# Copy this file to .env and uncomment what you need. Every setting is optional:
# with an empty .env, Zipcall runs on port 3000 using public STUN servers.

# The site's public address, used for the image in link previews. Without it,
# the address each request was made to is used, which is usually right.
# PUBLIC_URL=https://call.example.com

# Port for the web app and the signaling server.
# PORT=3000

# TURN relays let calls connect through strict firewalls and some mobile
# networks. Without them most calls still connect, but not all. Create a free
# Twilio account and copy the Account SID and Auth Token from
# https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token

# Or run your own TURN server (coturn) instead of Twilio: its URLs and the
# shared secret configured as its static-auth-secret (16+ characters). The
# Docker Compose "turn" profile runs one for you.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_SECRET=
# For the turn profile on a cloud server: its public IP address, if the
# machine itself only has a private one.
# TURN_EXTERNAL_IP=

# "relay" sends all media through the TURN server, so participants never
# learn each other's IP addresses (uses more bandwidth on the relay).
# ICE_TRANSPORT_POLICY=all

# Comma-separated STUN servers (default: stun:stun.l.google.com:19302).
# STUN_URLS=stun:stun.l.google.com:19302

# Redirect plain-HTTP requests to HTTPS when running behind a proxy that sets
# X-Forwarded-Proto. On by default on Heroku.
# FORCE_HTTPS=true

# Number of reverse proxies in front of the app (Caddy, nginx, a load
# balancer). The app then trusts that many X-Forwarded-For entries to find
# visitors' IP addresses for rate limiting. Leave at 0 if the app is exposed
# directly, or visitors could fake their address. Docker Compose sets it to 1.
# TRUST_PROXY=0

# Other origins allowed to connect to the signaling server, comma-separated.
# Only needed if the web app is served from a different domain.
# ALLOWED_ORIGINS=https://call.example.com

# Simultaneous connections allowed from one public IP address.
# MAX_CONNECTIONS_PER_IP=50

# Logging: debug, info, warn, or error; and json (one object per line, the
# default when NODE_ENV=production) or pretty.
# LOG_LEVEL=info
# LOG_FORMAT=json

# Enables Prometheus metrics at /metrics for requests with the header
# "Authorization: Bearer <token>". Use a long random value, e.g. from
# `openssl rand -hex 32`.
# METRICS_TOKEN=

# Docker Compose only. Where the app is published on the host; keep
# 127.0.0.1 unless something outside this machine must reach it directly.
# APP_PORT=3000
# APP_BIND=127.0.0.1

# Docker Compose "https" profile: the public hostname Caddy gets a
# certificate for. Point its DNS at this machine first.
# DOMAIN=call.example.com
