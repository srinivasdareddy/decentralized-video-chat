{
  "name": "zipcall",
  "version": "2.0.0",
  "private": true,
  "description": "Peer-to-peer video calls in the browser, powered by WebRTC",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.ts",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
